{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "backend/dist/**",
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "installCommand": "npm install && cd backend && npm install && cd ../frontend && npm install"
}